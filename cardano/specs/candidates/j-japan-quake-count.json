      "maxlatitude": 46,
      "minlongitude": 129,
      "maxlongitude": 146,
      "minmagnitude": 5,
      "eventtype": "earthquake"
    },
    "responseProjection": {
      "value": "/count"
    }
  },
  "use": [
    "value"
  ],
  "cmp": "AtLeast",
  "kind": "static",
  "scale": 0
}
