            },
            {
              "title": "deadline_ms",
              "description": "A release must be valid before this time, a refund only after it (POSIX milliseconds).",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "max_age_ms",
              "description": "Maximum age of the attestation when the transaction is validated (milliseconds).",
